[Unit]
Description=Aerotone lead receiving adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aerotone
Group=aerotone
WorkingDirectory=/opt/aerotone/backend
EnvironmentFile=/etc/aerotone/lead.env
ExecStart=/usr/bin/python3 /opt/aerotone/backend/lead_server.py
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=aerotone
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aerotone

[Install]
WantedBy=multi-user.target
