# Include only in the dedicated HTTPS server {} for the landing.
# Set server_name / root / TLS in the host's panel; this file does not provision TLS.
# server_name b2b.aerotone.ru;
# root /var/www/aerotone/current;
index index.html;
autoindex off;
add_header X-Robots-Tag "noindex, nofollow" always;

location / {
    try_files $uri $uri/ =404;
}

# Enable only AFTER configuring and testing the private receiving service.
location = /api/leads {
    client_max_body_size 12k;
    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host $host;
    # Overwrite the visitor-supplied header. Trust only this local proxy in the app.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;
    proxy_read_timeout 25s;
    proxy_send_timeout 25s;
}

# Do not expose hidden files; keep ACME certificate challenges available.
location ~ /\.(?!well-known/) {
    deny all;
}
